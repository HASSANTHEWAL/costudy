{
  "name": "costudy-functions",
  "version": "0.1.0",
  "private": true,
  "description": "CoStudy server-side logic: coalition formation engine and auth blocking functions.",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "jest",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-costudy-rules --only firestore \"jest --config jest.rules.config.js\"",
    "bench": "node bench/coalitionEngine.bench.js",
    "serve": "firebase emulators:start --config ../firebase.json --only functions,auth,firestore",
    "test:e2e": "firebase emulators:exec --config ../firebase.json --project demo-costudy-e2e --only firestore \"jest --config jest.e2e.config.js\""
  },
  "jest": {
    "//": "The rules suite needs a running Firestore emulator, so `npm test` skips it. Run it with `npm run test:rules`, which starts the emulator around it.",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/firestore.rules.test.js",
      "<rootDir>/test/e2e/"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.26.0",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  }
}
